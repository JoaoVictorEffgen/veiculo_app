rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && userDoc().role == 'admin';
    }

    function isOwnFcmTokenUpdate(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken', 'fcmTokenUpdatedAt']);
    }

    function vehicleIdentityUnchanged() {
      return request.resource.data.name == resource.data.name
        && request.resource.data.model == resource.data.model
        && request.resource.data.plate == resource.data.plate;
    }

    function canOperateVehicle() {
      return isSignedIn()
        && vehicleIdentityUnchanged()
        && (
          (resource.data.status == 'stopped'
            && request.resource.data.status == 'moving'
            && request.resource.data.currentDriverId == request.auth.uid)
          ||
          (resource.data.status == 'moving'
            && request.resource.data.status == 'stopped'
            && resource.data.currentDriverId == request.auth.uid)
        );
    }

    function isExpiredAnnouncement() {
      return resource.data.expiresAt != null
        && resource.data.expiresAt <= request.time;
    }

    function isDriverAnnouncementResponse() {
      return isSignedIn()
        && resource.data.targetDriverId == request.auth.uid
        && resource.data.responseStatus == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['responseStatus', 'respondedAt', 'respondedByName'])
        && request.resource.data.responseStatus in ['completed', 'rejected'];
    }

    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow update: if isAdmin() || isOwnFcmTokenUpdate(userId);
      allow delete: if isAdmin();
    }

    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || canOperateVehicle();
    }

    match /movements/{movementId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.driverId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.driverId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /tracking/{driverId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == driverId);
      allow create, update: if isSignedIn() && request.auth.uid == driverId;
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == driverId);
    }

    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() || isDriverAnnouncementResponse();
      allow delete: if isAdmin() || (isSignedIn() && isExpiredAnnouncement());
    }
  }
}
