rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function isAdmin() {
      return isSignedIn() && userDoc() != null && userDoc().role == 'admin';
    }

    function isOwnUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isOwnFcmTokenUpdate(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken', 'fcmTokenUpdatedAt']);
    }

    function vehicleIdentityUnchanged() {
      return request.resource.data.name == resource.data.name
        && request.resource.data.model == resource.data.model
        && request.resource.data.plate == resource.data.plate;
    }

    function canOperateVehicle() {
      return isSignedIn()
        && vehicleIdentityUnchanged()
        && (
          (resource.data.status == 'stopped'
            && request.resource.data.status == 'moving'
            && request.resource.data.currentDriverId == request.auth.uid)
          ||
          (resource.data.status == 'moving'
            && request.resource.data.status == 'stopped'
            && resource.data.currentDriverId == request.auth.uid)
        );
    }

    function isExpiredAnnouncement() {
      return resource.data.expiresAt != null
        && resource.data.expiresAt <= request.time;
    }

    function isDriverAnnouncementResponse() {
      return isSignedIn()
        && resource.data.targetDriverId == request.auth.uid
        && resource.data.get('responseStatus', null) == null
        && announcementIsActive(resource.data)
        && request.resource.data.active == false
        && request.resource.data.responseStatus in ['completed', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['responseStatus', 'respondedAt', 'respondedByName', 'rejectionReason', 'active'])
        && (
          request.resource.data.responseStatus == 'completed'
          || (
            request.resource.data.responseStatus == 'rejected'
            && request.resource.data.rejectionReason is string
            && request.resource.data.rejectionReason.size() > 0
          )
        );
    }

    function isGroupAnnouncementData(data) {
      return !('targetDriverId' in data) || data.targetDriverId == null;
    }

    function announcementIsActive(data) {
      return data.get('active', true) == true;
    }

    function isDriverCompletingGroupTaskUpdate() {
      return isSignedIn()
        && isGroupAnnouncementData(resource.data)
        && announcementIsActive(resource.data)
        && resource.data.get('responseStatus', null) == null
        && request.resource.data.active == false
        && request.resource.data.responseStatus == 'completed'
        && request.resource.data.respondedByName is string
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['active', 'responseStatus', 'respondedAt', 'respondedByName']);
    }

    function isDriverCompletingGroupTask() {
      return isSignedIn()
        && isGroupAnnouncementData(resource.data)
        && announcementIsActive(resource.data);
    }

    function isDriverAdminAlertCreate() {
      return isSignedIn()
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.driverName is string
        && request.resource.data.message is string
        && request.resource.data.announcementId is string
        && request.resource.data.viewed == false
        && request.resource.data.responseStatus in ['completed', 'rejected'];
    }

    function isDriverDeletingOwnReminder() {
      return isSignedIn()
        && resource.data.targetDriverId == request.auth.uid
        && announcementIsActive(resource.data);
    }

    function isDriverChecklistCreate(checklistId) {
      return isSignedIn()
        && request.resource.data.driverId == request.auth.uid
        && checklistId == request.auth.uid + '_' + request.resource.data.vehicleId + '_' + request.resource.data.checklistDate
        && request.resource.data.checklistDate is string
        && request.resource.data.vehicleId is string
        && request.resource.data.items is map;
    }

    function isDriverChecklistUpdate(checklistId) {
      return isSignedIn()
        && resource.data.driverId == request.auth.uid
        && request.resource.data.driverId == request.auth.uid
        && checklistId == request.auth.uid + '_' + request.resource.data.vehicleId + '_' + request.resource.data.checklistDate;
    }

    function canReadChecklist(checklistId) {
      return isAdmin()
        || (isSignedIn() && resource.data.driverId == request.auth.uid)
        || (isSignedIn() && checklistId.matches('^' + request.auth.uid + '_.*'));
    }

    function isOwnProfileUpdate(userId) {
      return isOwnUser(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'role']);
    }

    match /users/{userId} {
      allow read: if isOwnUser(userId) || isAdmin();
      allow create: if isOwnUser(userId) || isAdmin();
      allow update: if isAdmin() || isOwnFcmTokenUpdate(userId) || isOwnProfileUpdate(userId);
      allow delete: if isAdmin();
    }

    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || canOperateVehicle();

      match /maintenance_chunks/{chunkId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }

      match /maintenance_logs/{logId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isAdmin();
      }
    }

    match /movements/{movementId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.driverId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.driverId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /tracking/{driverId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == driverId);
      allow create, update: if isSignedIn() && request.auth.uid == driverId;
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == driverId);
    }

    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() || isDriverAnnouncementResponse() || isDriverCompletingGroupTaskUpdate();
      allow delete: if isAdmin() || (isSignedIn() && isExpiredAnnouncement()) || isDriverDeletingOwnReminder() || isDriverCompletingGroupTask();
    }

    match /admin_alerts/{alertId} {
      allow read: if isAdmin();
      allow create: if isDriverAdminAlertCreate();
      allow update, delete: if isAdmin();
    }

    match /vehicle_checklists/{checklistId} {
      allow read: if canReadChecklist(checklistId);
      allow create: if isDriverChecklistCreate(checklistId);
      allow update: if isAdmin() || isDriverChecklistUpdate(checklistId);
      allow delete: if isAdmin();
    }

    match /driver_reports/{reportId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.driverId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.driverName is string
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0;
      allow update, delete: if isAdmin();
    }
  }
}
