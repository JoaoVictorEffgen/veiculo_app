rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && userDoc().role == 'admin';
    }

    function userCompanyId() {
      return userDoc().get('companyId', 'default');
    }

    function sameCompany(data) {
      return data.get('companyId', 'default') == userCompanyId();
    }

    function sameCompanyResource() {
      return sameCompany(resource.data);
    }

    function sameCompanyRequest() {
      return sameCompany(request.resource.data);
    }

    function isOwnFcmTokenUpdate(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken', 'fcmTokenUpdatedAt']);
    }

    function vehicleIdentityUnchanged() {
      return request.resource.data.name == resource.data.name
        && request.resource.data.model == resource.data.model
        && request.resource.data.plate == resource.data.plate;
    }

    function canOperateVehicle() {
      return isSignedIn()
        && sameCompanyResource()
        && sameCompanyRequest()
        && vehicleIdentityUnchanged()
        && (
          (resource.data.status == 'stopped'
            && request.resource.data.status == 'moving'
            && request.resource.data.currentDriverId == request.auth.uid)
          ||
          (resource.data.status == 'moving'
            && request.resource.data.status == 'stopped'
            && resource.data.currentDriverId == request.auth.uid)
        );
    }

    function isExpiredAnnouncement() {
      return resource.data.expiresAt != null
        && resource.data.expiresAt <= request.time;
    }

    function isGroupOrAssignedTask(data) {
      return data.get('targetDriverId', null) == null
        || data.get('targetDriverId', '') == ''
        || data.targetDriverId == request.auth.uid;
    }

    function isDriverStartingTask() {
      return isSignedIn()
        && sameCompanyResource()
        && sameCompanyRequest()
        && announcementIsActive(resource.data)
        && resource.data.get('responseStatus', null) == null
        && resource.data.get('startedById', null) == null
        && isGroupOrAssignedTask(resource.data)
        && request.resource.data.get('startedById', null) == request.auth.uid
        && request.resource.data.get('startedByName', null) is string
        && request.resource.data.get('startedByName', '').size() > 0
        && (
          request.writeFields.hasOnly(['startedById', 'startedByName', 'startedAt'])
          || request.writeFields.hasOnly(['startedById', 'startedByName', 'startedAt', 'routePoints'])
        );
    }

    function isDriverAnnouncementResponse() {
      return isSignedIn()
        && sameCompanyResource()
        && sameCompanyRequest()
        && resource.data.targetDriverId == request.auth.uid
        && resource.data.get('responseStatus', null) == null
        && announcementIsActive(resource.data)
        && request.resource.data.active == false
        && request.resource.data.responseStatus in ['completed', 'rejected']
        && request.writeFields.hasOnly(['responseStatus', 'respondedAt', 'respondedByName', 'rejectionReason', 'active'])
        && (
          (
            request.resource.data.responseStatus == 'completed'
            && resource.data.get('startedById', null) == request.auth.uid
          )
          || (
            request.resource.data.responseStatus == 'rejected'
            && resource.data.get('startedById', null) == null
            && request.resource.data.rejectionReason is string
            && request.resource.data.rejectionReason.size() > 0
          )
        );
    }

    function isGroupAnnouncementData(data) {
      return !('targetDriverId' in data) || data.targetDriverId == null;
    }

    function announcementIsActive(data) {
      return data.get('active', true) == true;
    }

    function isDriverCompletingGroupTaskUpdate() {
      return isSignedIn()
        && sameCompanyResource()
        && sameCompanyRequest()
        && isGroupAnnouncementData(resource.data)
        && announcementIsActive(resource.data)
        && resource.data.get('responseStatus', null) == null
        && resource.data.get('startedById', null) == request.auth.uid
        && request.resource.data.active == false
        && request.resource.data.responseStatus == 'completed'
        && request.resource.data.respondedByName is string
        && request.writeFields.hasOnly(['active', 'responseStatus', 'respondedAt', 'respondedByName']);
    }

    function isDriverCompletingGroupTask() {
      return isSignedIn()
        && isGroupAnnouncementData(resource.data)
        && announcementIsActive(resource.data);
    }

    function isDriverAdminAlertCreate() {
      return isSignedIn()
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.get('companyId', 'default') == userCompanyId()
        && request.resource.data.driverName is string
        && request.resource.data.message is string
        && request.resource.data.announcementId is string
        && request.resource.data.viewed == false
        && request.resource.data.responseStatus in ['completed', 'rejected'];
    }

    function isDriverDeletingOwnReminder() {
      return isSignedIn()
        && resource.data.targetDriverId == request.auth.uid
        && announcementIsActive(resource.data);
    }

    function isChecklistCreate(checklistId) {
      return isSignedIn()
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.companyId is string
        && request.resource.data.checklistDate is string
        && request.resource.data.vehicleId is string
        && request.resource.data.items is map
        && checklistId == request.auth.uid + '_' + request.resource.data.vehicleId + '_' + request.resource.data.checklistDate;
    }

    function isDriverChecklistUpdate(checklistId) {
      return isSignedIn()
        && resource.data.driverId == request.auth.uid
        && request.resource.data.driverId == request.auth.uid
        && checklistId == request.auth.uid + '_' + request.resource.data.vehicleId + '_' + request.resource.data.checklistDate;
    }

    function canReadChecklist() {
      return (isAdmin() && sameCompanyResource())
        || (isSignedIn() && resource.data.driverId == request.auth.uid);
    }

    function isRegisteringCompanyAdmin(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'admin'
        && request.resource.data.companyId is string
        && request.resource.data.email is string
        && request.resource.data.name is string
        && get(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.ownerId == request.auth.uid;
    }

    match /companies/{companyId} {
      allow read: if isSignedIn()
        && (companyId == userCompanyId() || resource.data.ownerId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.active == true;
      allow update: if isAdmin() && companyId == userCompanyId();
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if isSignedIn()
        && (request.auth.uid == userId || (isAdmin() && sameCompanyResource()));
      allow create: if (isAdmin() && sameCompanyRequest())
        || isRegisteringCompanyAdmin(userId);
      allow update: if (isAdmin() && sameCompanyResource() && sameCompanyRequest())
        || isOwnFcmTokenUpdate(userId);
      allow delete: if isAdmin() && sameCompanyResource();
    }

    match /vehicles/{vehicleId} {
      allow read: if isSignedIn() && sameCompanyResource();
      allow create, delete: if isAdmin() && sameCompanyRequest();
      allow update: if (isAdmin() && sameCompanyResource() && sameCompanyRequest()) || canOperateVehicle();

      match /maintenance_chunks/{chunkId} {
        allow read: if isSignedIn() && sameCompany(get(/databases/$(database)/documents/vehicles/$(vehicleId)).data);
        allow write: if isAdmin() && sameCompany(get(/databases/$(database)/documents/vehicles/$(vehicleId)).data);
      }

      match /maintenance_logs/{logId} {
        allow read: if isSignedIn() && sameCompany(get(/databases/$(database)/documents/vehicles/$(vehicleId)).data);
        allow create, update, delete: if isAdmin() && sameCompany(get(/databases/$(database)/documents/vehicles/$(vehicleId)).data);
      }
    }

    match /movements/{movementId} {
      allow read: if isSignedIn()
        && ((isAdmin() && sameCompanyResource()) || resource.data.driverId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.driverId == request.auth.uid
        && sameCompanyRequest();
      allow update, delete: if isAdmin() && sameCompanyResource();
    }

    match /tracking/{driverId} {
      allow read: if isSignedIn()
        && ((isAdmin() && sameCompanyResource()) || request.auth.uid == driverId);
      allow create, update: if isSignedIn()
        && request.auth.uid == driverId
        && sameCompanyRequest();
      allow delete: if (isAdmin() && sameCompanyResource()) || (isSignedIn() && request.auth.uid == driverId);
    }

    match /announcements/{announcementId} {
      allow read: if isSignedIn() && sameCompanyResource();
      allow create: if isAdmin() && sameCompanyRequest();
      allow update: if isAdmin() || isDriverStartingTask() || isDriverAnnouncementResponse() || isDriverCompletingGroupTaskUpdate();
      allow delete: if isAdmin() || (isSignedIn() && isExpiredAnnouncement()) || isDriverDeletingOwnReminder() || isDriverCompletingGroupTask();
    }

    match /admin_alerts/{alertId} {
      allow read: if isAdmin() && sameCompanyResource();
      allow create: if isDriverAdminAlertCreate();
      allow update, delete: if isAdmin() && sameCompanyResource();
    }

    match /vehicle_checklists/{checklistId} {
      allow read: if canReadChecklist();
      allow create: if isChecklistCreate(checklistId);
      allow update: if isAdmin() || isDriverChecklistUpdate(checklistId);
      allow delete: if isAdmin();
    }

    match /driver_reports/{reportId} {
      allow read: if isSignedIn()
        && ((isAdmin() && sameCompanyResource()) || resource.data.driverId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.driverId == request.auth.uid
        && sameCompanyRequest()
        && request.resource.data.driverName is string
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0;
      allow update, delete: if isAdmin() && sameCompanyResource();
    }
  }
}
